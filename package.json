{
  "name": "ag2rn",
  "version": "2.0.0",
  "description": "AG2RN — Antigravity 2.0 Remote Native. Cross-platform desktop server and native iOS/Android companion suite for Antigravity 2.0.",
  "type": "module",
  "main": "packages/desktop/src/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node packages/core/test/lifecycle.test.js",
    "desktop": "electron packages/desktop/src/main.js",
    "desktop:dist": "electron-builder --win",
    "desktop:dist:mac": "electron-builder --mac",
    "desktop:dist:linux": "electron-builder --linux",
    "mobile:build": "node packages/mobile/build-mobile.js"
  },
  "keywords": [
    "antigravity",
    "antigravity-2.0",
    "remote",
    "native",
    "ios",
    "android",
    "electron",
    "cdp",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "chrome-remote-interface": "^0.33.2",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ag2rn.desktop",
    "productName": "AG2RN Control Center",
    "asar": false,
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "packages/core/**/*",
      "packages/desktop/**/*",
      "public/**/*",
      "src/**/*",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/ag2r-icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/ag2r-icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/ag2r-icon.png",
      "category": "Development"
    }
  }
}
